rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to everyone (public images)
      allow read: if true;
      // Allow write access only to authenticated users
      // Added file metadata validation for basic security
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024 // 5MB limit matching client-side
                   && request.resource.contentType.matches('image/.*');
    }
  }
}