rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read own doc or admin reads all; write own doc (cannot self-approve) or admin updates any
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'rindra.it@gmail.com'
      );

      allow create: if request.auth != null && request.auth.uid == userId
        && (request.resource.data.get('approvalStatus', 'none') != 'approved'
          || request.auth.token.email == 'rindra.it@gmail.com');

      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.get('approvalStatus', 'none') != 'approved')
        || request.auth.token.email == 'rindra.it@gmail.com'
      );
    }

    // Collections: any authed user can read, owner can CRUD (pending teachers cannot create)
    match /collections/{collectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approvalStatus', 'none') != 'pending';
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Quizzes: owner can CRUD, anyone can read public quizzes, authed users can read all (pending teachers cannot create)
    match /quizzes/{quizId} {
      allow read: if request.auth != null || resource.data.visibility == 'public';
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approvalStatus', 'none') != 'pending';
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Questions: readable by anyone (students play without auth), writable by authed users
    match /questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sessions: host can write, players can read
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      // Players subcollection
      match /players/{playerId} {
        allow read: if true;
        allow create: if true;
      }

      // Answers: write only during live question, via Cloud Functions
      match /answers/{answerId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // Leaderboard shards: read-only for clients
      match /leaderboard_shards/{shardId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // Analytics: read by host
      match /analytics/{questionId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // Violations: read-only for clients, write via Cloud Functions only
      match /violations/{playerId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
