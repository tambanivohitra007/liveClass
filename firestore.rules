rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read own profile, write own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Collections: any authed user can read, owner can CRUD
    match /collections/{collectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Quizzes: owner can CRUD, students can read public quizzes
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Questions: readable if authed, writable by quiz owner
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Sessions: host can write, players can read
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      // Players subcollection
      match /players/{playerId} {
        allow read: if true;
        allow create: if true;
      }

      // Answers: write only during live question, via Cloud Functions
      match /answers/{answerId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // Leaderboard shards: read-only for clients
      match /leaderboard_shards/{shardId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // Analytics: read by host
      match /analytics/{questionId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // Violations: read-only for clients, write via Cloud Functions only
      match /violations/{playerId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
